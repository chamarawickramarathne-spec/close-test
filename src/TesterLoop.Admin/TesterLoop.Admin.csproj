<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TesterLoopAdmin</AssemblyName>
    <RootNamespace>TesterLoop.Admin</RootNamespace>
    <Version>0.18.0</Version>
    <Company>TesterLoop</Company>
    <Product>TesterLoop Admin</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <ApplicationIcon>..\..\media\icons\testerloop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TesterLoop.Shared\TesterLoop.Shared.csproj" />
  </ItemGroup>

</Project>


