<UserControl x:Class="TesterLoop.Admin.Views.AdminAuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Audit trail" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="A read-only record of every action recorded by the TesterLoop backend."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding AuditCountLabel}" FontSize="11.5"
                                   Foreground="{StaticResource InkSoftBrush}" />
                    </Border>
                    <Button Content="Refresh"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11.5"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="WHEN" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="1" Text="ACTOR" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="2" Text="ACTION" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="3" Text="TARGET" Style="{StaticResource Eyebrow}" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ItemsControl ItemsSource="{Binding Audit}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="210" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding At, StringFormat={}{0:yyyy-MM-dd}}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource InkSoftBrush}" />
                                            <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Actor}" FontSize="11.5"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Actor}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Action}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10.5"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Action}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Target}"
                                                   Style="{StaticResource Body}"
                                                   FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Target}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No audit entries yet."
                               Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAudit}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
