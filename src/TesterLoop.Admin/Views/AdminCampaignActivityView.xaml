<UserControl x:Class="TesterLoop.Admin.Views.AdminCampaignActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="DetailEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border Style="{StaticResource Card}" Padding="20,18">
            <StackPanel>
                <TextBlock Text="REPORTS" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Text="What testers submitted on this project, with the usage state captured when each report was filed."
                           Style="{StaticResource Caption}" Margin="0,4,0,0" />

                <Grid Margin="0,14,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="62" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="REPORT" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="1" Text="TESTER" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="2" Text="SEVERITY" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="4" Text="USAGE AT FILING" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="5" Text="FILED" Style="{StaticResource DetailEyebrow}"
                               TextAlignment="Right" />
                </Grid>

                <Border Height="1" Background="{StaticResource LineBrush}" />

                <ItemsControl ItemsSource="{Binding CampaignDetail.Reports}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                    Padding="0,8">
                                <Grid ToolTip="{Binding Tooltip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="62" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}" />
                                        <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   FontSize="9.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Evidence}" FontSize="9.5"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Evidence}"
                                                   Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Tester}" FontSize="10.5"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Tester}" />
                                    <TextBlock Grid.Column="2" Text="{Binding SeverityLabel}" FontSize="10.5"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SeverityTone}" Value="bad">
                                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SeverityTone}" Value="warn">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="10.5"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding StatusTone}" Value="good">
                                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding StatusTone}" Value="warn">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{Binding UsageLabel}" FontSize="10"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UsageTone}" Value="good">
                                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UsageTone}" Value="warn">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="5" Text="{Binding Filed}"
                                               Style="{StaticResource Caption}" FontSize="10"
                                               VerticalAlignment="Center" TextAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No reports have been filed on this project." Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CampaignDetail.HasReports}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
            <StackPanel>
                <TextBlock Text="PROJECT HISTORY" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Text="The last 50 audit entries recorded against this project."
                           Style="{StaticResource Caption}" Margin="0,4,0,0" />

                <Grid Margin="0,14,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="WHEN" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="1" Text="ACTOR" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="2" Text="ACTION" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Grid.Column="3" Text="TARGET" Style="{StaticResource DetailEyebrow}" />
                </Grid>

                <Border Height="1" Background="{StaticResource LineBrush}" />

                <ItemsControl ItemsSource="{Binding CampaignDetail.Audit}" Margin="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                    Padding="0,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" FontSize="10" />
                                    <TextBlock Grid.Column="1" Text="{Binding Actor}" FontSize="10"
                                               Foreground="{StaticResource InkSoftBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Action}" FontSize="10"
                                               Foreground="{StaticResource InkBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Target}"
                                               Style="{StaticResource Caption}" FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Target}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No audit entries recorded for this project yet." Margin="0,14,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CampaignDetail.HasAudit}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
