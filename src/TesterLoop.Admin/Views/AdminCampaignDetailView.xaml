<UserControl x:Class="TesterLoop.Admin.Views.AdminCampaignDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TesterLoop.Admin.Views"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="DetailMetric" TargetType="TextBlock" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <StackPanel Orientation="Horizontal">
                <Button Content="Back to projects"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackToCampaignsCommand}" />
                <Button Content="Refresh project"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshCampaignCommand}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding CampaignDetail.AppName}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding CampaignDetail.Package, Mode=OneWay}" />
                        <Run Text=" &#183; " />
                        <Run Text="{Binding CampaignDetail.Developer, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding CampaignDetail.DeveloperContact, Mode=OneWay}" />
                        <Run Text=" &#183; " />
                        <Run Text="{Binding CampaignDetail.DeveloperGoogle, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}">
                        <Run Text="Created " />
                        <Run Text="{Binding CampaignDetail.Created, Mode=OneWay}" />
                        <Run Text=" &#183; first opt-in " />
                        <Run Text="{Binding CampaignDetail.FirstOptIn, Mode=OneWay}" />
                        <Run Text=" &#183; clock " />
                        <Run Text="{Binding CampaignDetail.Started, Mode=OneWay}" />
                        <Run Text=" &#183; eligible " />
                        <Run Text="{Binding CampaignDetail.EligibleOn, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding CampaignDetail.StateLabel}" FontSize="11">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CampaignDetail.StateTone}" Value="good">
                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CampaignDetail.StateTone}" Value="bad">
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding CampaignDetail.HasUsageNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding CampaignDetail.UsageNotice}" FontSize="11"
                           Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="TESTERS USED" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.TestersLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="OPTED IN" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.OptedLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="SEATS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.SeatsLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,14" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="REPORTS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.ReportsLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="USAGE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.UsageLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="PAYOUTS DUE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.PayoutDueLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="PAYOUTS PAID" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.PayoutPaidLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,14" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PROJECT FEE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding CampaignDetail.FeeLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="GOOGLE GROUP" Style="{StaticResource DetailEyebrow}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Address" Style="{StaticResource DetailLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding CampaignDetail.GroupEmail}"
                                       Style="{StaticResource DetailValue}" />
                            <TextBlock Grid.Row="1" Text="URL name" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CampaignDetail.GroupName}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="Display name" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CampaignDetail.GroupDisplayName}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="State" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CampaignDetail.GroupStateLabel}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Text="Settings" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CampaignDetail.GroupSettings}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PAYMENT" Style="{StaticResource DetailEyebrow}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Status" Style="{StaticResource DetailLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding CampaignDetail.PaymentLabel}" FontSize="11"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CampaignDetail.PaymentTone}" Value="good">
                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="1" Text="Reference" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CampaignDetail.PaymentReference}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="Paid" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CampaignDetail.PaidAt}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="Play link" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CampaignDetail.PlayLink}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <views:AdminCampaignTestersView Margin="0,16,0,0" />

            <views:AdminCampaignActivityView Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
