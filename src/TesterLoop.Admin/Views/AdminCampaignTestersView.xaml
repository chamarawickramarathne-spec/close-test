<UserControl x:Class="TesterLoop.Admin.Views.AdminCampaignTestersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="DetailEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="20,18">
        <StackPanel>
            <TextBlock Text="TESTERS" Style="{StaticResource DetailEyebrow}" />
            <TextBlock Text="Every seat ever used on this project. Dropped testers still count toward the 15-tester limit."
                       Style="{StaticResource Caption}" Margin="0,4,0,0" />

            <Grid Margin="0,14,0,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="104" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="TESTER" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Grid.Column="1" Text="SEAT" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Grid.Column="3" Text="OPT-IN" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Grid.Column="4" Text="USAGE" Style="{StaticResource DetailEyebrow}" />
                <TextBlock Grid.Column="5" Text="REPORTS" Style="{StaticResource DetailEyebrow}"
                           TextAlignment="Right" />
                <TextBlock Grid.Column="6" Text="PAYOUT" Style="{StaticResource DetailEyebrow}"
                           TextAlignment="Right" />
                <TextBlock Grid.Column="7" Text="PAID" Style="{StaticResource DetailEyebrow}"
                           TextAlignment="Right" />
            </Grid>

            <Border Height="1" Background="{StaticResource LineBrush}" />

            <ItemsControl ItemsSource="{Binding CampaignDetail.Testers}" Margin="0,2,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="78" />
                                    <ColumnDefinition Width="76" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" />
                                    <TextBlock Text="{Binding Google}" Style="{StaticResource Caption}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Google}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding SeatLabel}"
                                           Style="{StaticResource Caption}" FontSize="10"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="10"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateTone}" Value="good">
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateTone}" Value="warn">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="3" Text="{Binding OptInLabel}"
                                           Style="{StaticResource Caption}" FontSize="10"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding OptInLabel}" />
                                <StackPanel Grid.Column="4" VerticalAlignment="Center"
                                            ToolTip="{Binding UsageTooltip}">
                                    <TextBlock Text="{Binding UsageStateLabel}" FontSize="10"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UsageTone}" Value="good">
                                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding UsageTone}" Value="warn">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding UsageDetail}" Style="{StaticResource Caption}"
                                               FontSize="9.5"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{Binding ReportsLabel}"
                                           Style="{StaticResource Caption}" FontSize="10"
                                           VerticalAlignment="Center" TextAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="{Binding PayoutLabel}" FontSize="10"
                                           VerticalAlignment="Center" TextAlignment="Right">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PayoutTone}" Value="good">
                                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PayoutTone}" Value="warn">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="7" Text="{Binding PaidLabel}"
                                           Style="{StaticResource Caption}" FontSize="10"
                                           VerticalAlignment="Center" TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No testers have joined this project." Margin="0,14,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CampaignDetail.HasTesters}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
