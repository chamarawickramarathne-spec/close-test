<UserControl x:Class="TesterLoop.Admin.Views.AdminCampaignsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TesterLoop.Admin.Views"
             FontFamily="{StaticResource UiFont}">

    <TabControl SelectedIndex="{Binding CampaignPageIndex}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="Close test projects">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,36">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Close Test Projects" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Every close test project. Select a project to inspect its testers, reports, usage, payouts and history."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding CampaignTabLabel}" FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}" />
                            </Border>
                            <Button Content="Refresh"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}" FontSize="11.5"
                                   Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="78" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="APP" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="1" Text="DEVELOPER" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="2" Text="STATE" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="3" Text="PAYMENT" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="4" Text="TESTERS" Style="{StaticResource Eyebrow}"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="OPT-IN" Style="{StaticResource Eyebrow}"
                                           TextAlignment="Right" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineBrush}" />

                            <ListBox ItemsSource="{Binding Campaigns}"
                                     SelectedItem="{Binding SelectedCampaignRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,2,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="row" CornerRadius="7" Padding="0,9"
                                                            Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource SurfaceAltBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="Open this project">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="165" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="78" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding AppName}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding AppName}" />
                                                <TextBlock Text="{Binding Package}" Style="{StaticResource Caption}"
                                                           FontSize="10.5"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Package}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Developer}" FontSize="11.5"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Developer}" />
                                            <TextBlock Grid.Column="2" Text="{Binding StateLabel}" FontSize="10.5"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="good">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="3" Text="{Binding PaymentLabel}" FontSize="10.5"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaymentTone}" Value="good">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding SeatsLabel}" FontSize="11.5"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding OptedLabel}" Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No close test projects yet." Margin="0,14,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCampaigns}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Project detail">
            <views:AdminCampaignDetailView />
        </TabItem>

        <TabItem Header="Project report detail">
            <views:AdminReportDetailView />
        </TabItem>
    </TabControl>
</UserControl>
