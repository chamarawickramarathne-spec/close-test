<UserControl x:Class="TesterLoop.Admin.Views.AdminDeveloperDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="DetailMetric" TargetType="TextBlock" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <Button Content="Back to developers"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left"
                    Command="{Binding BackToDevelopersCommand}" />

            <Grid Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DeveloperDetail.Company}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding DeveloperDetail.DisplayName, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding DeveloperDetail.Contact, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}">
                        <Run Text="Google " />
                        <Run Text="{Binding DeveloperDetail.Google, Mode=OneWay}" />
                        <Run Text=" · joined " />
                        <Run Text="{Binding DeveloperDetail.Created, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,8">
                    <StackPanel>
                        <TextBlock Text="PROJECTS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding DeveloperDetail.ProjectsLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="4,0,4,8">
                    <StackPanel>
                        <TextBlock Text="TESTERS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding DeveloperDetail.TestersLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="8,0,0,8">
                    <StackPanel>
                        <TextBlock Text="PROJECT FEES PAID" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding DeveloperDetail.FeesPaidLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="PROJECT FEES DUE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding DeveloperDetail.FeesDueLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="TESTER PAYOUTS PAID" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding DeveloperDetail.PayoutsPaidLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TESTER PAYOUTS DUE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding DeveloperDetail.PayoutsDueLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="PROJECTS" Style="{StaticResource DetailEyebrow}" />

                    <Grid Margin="0,12,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="86" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PROJECT" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="1" Text="STATE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="2" Text="PAYMENT" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="3" Text="OPTED IN" Style="{StaticResource DetailEyebrow}"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="TESTERS" Style="{StaticResource DetailEyebrow}"
                                   TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="CREATED" Style="{StaticResource DetailEyebrow}"
                                   TextAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ItemsControl ItemsSource="{Binding DeveloperDetail.Campaigns}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="104" />
                                            <ColumnDefinition Width="86" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding AppName}" />
                                            <TextBlock Text="{Binding Package}" FontSize="10"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Package}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontSize="10"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding PaymentLabel}" FontSize="10"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaymentTone}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding OptedLabel}" Style="{StaticResource Caption}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Text="{Binding TestersLabel}" Style="{StaticResource Caption}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   TextAlignment="Right" />
                                        <TextBlock Grid.Column="5" Text="{Binding Created}" Style="{StaticResource Caption}"
                                                   FontSize="10" VerticalAlignment="Center"
                                                   TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="This developer has no projects yet." Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeveloperDetail.HasCampaigns}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="GOOGLE GROUPS" Style="{StaticResource DetailEyebrow}" />
                        <ItemsControl ItemsSource="{Binding DeveloperDetail.Groups}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Email}" FontSize="11"
                                                           Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Email}" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Caption}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StateLabel}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No groups attached yet." Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeveloperDetail.HasGroups}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TESTERS ON THESE PROJECTS" Style="{StaticResource DetailEyebrow}" />
                        <ItemsControl ItemsSource="{Binding DeveloperDetail.Testers}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource InkBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Google}" Style="{StaticResource Caption}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Google}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding ReportsLabel}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding DueLabel}"
                                                       Style="{StaticResource Caption}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No testers have joined this developer's projects." Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DeveloperDetail.HasTesters}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="RECENT AUDIT" Style="{StaticResource DetailEyebrow}" />
                    <ItemsControl ItemsSource="{Binding DeveloperDetail.Audit}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding When}" Style="{StaticResource Caption}"
                                                   FontSize="10" />
                                        <TextBlock Grid.Column="1" Text="{Binding Actor}" FontSize="10"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Action}" FontSize="10"
                                                   Foreground="{StaticResource InkBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding Target}" Style="{StaticResource Caption}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"
                                                   TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No audit entries for this developer yet." Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeveloperDetail.HasAudit}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
