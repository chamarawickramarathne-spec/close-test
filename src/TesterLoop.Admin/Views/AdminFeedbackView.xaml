<UserControl x:Class="TesterLoop.Admin.Views.AdminFeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TesterLoop.Admin.Views"
             FontFamily="{StaticResource UiFont}">

    <TabControl SelectedIndex="{Binding FeedbackPageIndex}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="Feedback list">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,36">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Feedback" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="Bug reports filed by testers against live close test projects. Select a report to read it in full."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding FeedbackTabLabel}" FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}" />
                            </Border>
                            <Button Content="Refresh"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}" FontSize="11.5"
                                   Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="95" />
                                    <ColumnDefinition Width="82" />
                                    <ColumnDefinition Width="74" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="REPORT" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="1" Text="CAMPAIGN" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="2" Text="TESTER" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="3" Text="SEVERITY" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="5" Text="AGE" Style="{StaticResource Eyebrow}"
                                           TextAlignment="Right" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineBrush}" />

                            <ListBox ItemsSource="{Binding Feedbacks}"
                                     SelectedItem="{Binding SelectedFeedbackRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,2,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="row"
                                                            BorderBrush="{StaticResource LineBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            CornerRadius="7"
                                                            Padding="0,9"
                                                            Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource SurfaceAltBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppName}" FontSize="11"
                                                           Foreground="{StaticResource InkSoftBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding AppName}" />
                                                <TextBlock Text="{Binding Developer}" Style="{StaticResource Caption}"
                                                           FontSize="10"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Tester}" FontSize="11"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Tester}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Severity}" FontSize="10.5"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SeverityTone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SeverityTone}" Value="bad">
                                                                <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="4" Text="{Binding Status}" FontSize="10.5"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="warn">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding StatusTone}" Value="good">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="5" Text="{Binding Age}" Style="{StaticResource Caption}"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No tester feedback yet." Margin="0,14,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFeedback}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Feedback detail">
            <views:AdminReportDetailView />
        </TabItem>
    </TabControl>
</UserControl>
