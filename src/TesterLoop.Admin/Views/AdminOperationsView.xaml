<UserControl x:Class="TesterLoop.Admin.Views.AdminOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Operations queue" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="Record the project fee, create the exact Google Group, confirm its settings, then attach it."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Manual check guide"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ManualCheckCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Open Google Groups"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding OpenGroupsCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Refresh"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11.5"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource GoodSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Toast}" FontSize="11.5"
                           Foreground="{StaticResource GoodBrush}" TextWrapping="Wrap" />
            </Border>

            <UniformGrid Columns="5" Margin="0,16,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="DEVELOPERS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding DeveloperCount}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="PENDING" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding PendingCount}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROJECTS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding LiveCount}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="TESTERS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding TesterCount}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="GROUPS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding GroupCount}" Style="{StaticResource Metric}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="PROJECTS AWAITING PAYMENT" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Confirming the fee reserves the group number and selects the project. Use Open create page to build the group, confirm its settings, then attach the reserved identity by hand. Google does not allow apps to create @gmail.com groups."
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding PaymentCountLabel}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding Payments}"
                                 SelectedItem="{Binding SelectedPayment}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="220">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" CornerRadius="8" Padding="10,8" Margin="0,2"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background"
                                                                Value="{StaticResource SurfaceAltBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background"
                                                                Value="{StaticResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0">
                                                <Run Text="{Binding Developer, Mode=OneWay}" />
                                                <Run Text=" &#183; " />
                                                <Run Text="{Binding Reference, Mode=OneWay}" />
                                                <Run Text=" &#183; " />
                                                <Run Text="{Binding Age, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Amount}" FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding SelectedPaymentLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Payment reference (optional)"
                                       Style="{StaticResource Caption}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Record the bank or transfer reference so the audit trail is useful."
                                       Style="{StaticResource Caption}" FontSize="10.5"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                            <Button Content="{Binding ConfirmPaymentLabel}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ConfirmPaymentCommand}"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="No project is waiting for a payment."
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPayments}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="GROUPS TO CREATE" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="Google has no create API for @gmail.com groups. Use the reserved address and display name on Google's create page, confirm all five settings, then attach. If either is taken, issue the next number."
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{Binding GroupSetupCountLabel}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <ListBox ItemsSource="{Binding GroupSetup}"
                                 SelectedItem="{Binding SelectedGroupSetup}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="310">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" CornerRadius="8" Padding="10,8" Margin="0,2"
                                                        Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background"
                                                                Value="{StaticResource SurfaceAltBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background"
                                                                Value="{StaticResource AccentSoftBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="58" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,2,0,0">
                                                <Run Text="{Binding Developer, Mode=OneWay}" />
                                                <Run Text=" &#183; " />
                                                <Run Text="{Binding SequenceLabel, Mode=OneWay}" />
                                                <Run Text=" &#183; " />
                                                <Run Text="{Binding Age, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ReservedEmail}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10" Foreground="{StaticResource InkSoftBrush}"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ReservedDisplayName}" Style="{StaticResource Caption}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Package}" Style="{StaticResource Caption}"
                                                   FontSize="9.5" TextAlignment="Right" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock Text="{Binding SelectedGroupSetupLabel}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSoftBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="Reserved group address" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding SelectedGroupSetup.ReservedEmail}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="11" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                            <Button Content="Copy address"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyReservedEmailCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />

                            <TextBlock Text="Reserved display name" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                            <TextBlock Text="{Binding SelectedGroupSetup.ReservedDisplayName}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                            <Button Content="Copy display name"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding CopyReservedDisplayCommand}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" />

                            <TextBlock Text="Group settings" Style="{StaticResource Caption}" Margin="0,12,0,4" />
                            <TextBlock Style="{StaticResource Caption}" FontSize="10.5" TextWrapping="Wrap">
                                <Run Text="&#8226; Who can see group: Anyone on the web" /><LineBreak />
                                <Run Text="&#8226; Who can join group: Anyone on the web" /><LineBreak />
                                <Run Text="&#8226; Who can modify group details: Group managers" /><LineBreak />
                                <Run Text="&#8226; Who can view conversations: Group managers" /><LineBreak />
                                <Run Text="&#8226; Who can view members: Group owners" />
                            </TextBlock>

                            <TextBlock Text="Actual group URL name" Style="{StaticResource Caption}" Margin="0,10,0,4" />
                            <TextBox Text="{Binding GroupUrlName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="The last part of groups.google.com/g/. Edit it only if Google chose a different one."
                                       Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReservedGroupPageLabel}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="10" Foreground="{StaticResource InkSoftBrush}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />

                            <Button Content="Open create page"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding OpenGroupCreateCommand}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" />

                            <CheckBox Content="I created this group and all five settings match."
                                      IsChecked="{Binding GroupSettingsConfirmed}"
                                      Margin="0,10,0,0" />

                            <Button Content="Attach group"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AttachGroupCommand}"
                                    IsEnabled="{Binding CanAttachGroup}"
                                    HorizontalAlignment="Left" Margin="0,12,0,0" />

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Content="Issue next number"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding RotateGroupCommand}"
                                        IsEnabled="{Binding CanRotateGroup}"
                                        HorizontalAlignment="Left" />
                                <Button Grid.Column="1" Content="Copy URL name"
                                        Style="{StaticResource GhostButton}"
                                        Command="{Binding CopyReservedUrlNameCommand}"
                                        Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="No paid project is waiting for a group."
                               Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasGroupSetup}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="GOOGLE GROUPS" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding ManualLabel}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="84" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Email}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Caption}"
                                                       FontSize="10.5" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,2,0,0">
                                                <Run Text="groups.google.com/g/" />
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,2,0,0">
                                                <Run Text="{Binding Developer, Mode=OneWay}" />
                                                <Run Text=" &#183; " />
                                                <Run Text="{Binding Members, Mode=OneWay}" />
                                                <Run Text=" &#183; " />
                                                <Run Text="{Binding SettingsLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontSize="10.5"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="muted">
                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <TextBlock Text="CLOSE TEST PROJECTS" Style="{StaticResource Eyebrow}" />
                        <ItemsControl ItemsSource="{Binding Campaigns}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Developer}" Style="{StaticResource Caption}"
                                                       FontSize="10.5" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StateLabel}" FontSize="10.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding OptedLabel}" Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
