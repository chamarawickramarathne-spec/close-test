<UserControl x:Class="TesterLoop.Admin.Views.AdminPackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Payment packages" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="A developer picks one package when creating a project. The project fee and tester payout are copied onto that project, so changing a package never rewrites an existing project."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" MaxWidth="720" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="12,6"
                            Margin="0,0,8,0">
                        <TextBlock Text="{Binding PackageCountLabel}" FontSize="11.5"
                                   Foreground="{StaticResource InkSoftBrush}" />
                    </Border>
                    <Button Content="New package"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewPackageCommand}"
                            Margin="0,0,8,0" />
                    <Button Content="Refresh"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11.5"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding IsPackageEditorOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding PackageEditorTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PACKAGE NAME" Style="{StaticResource Eyebrow}" />
                            <TextBox Text="{Binding PackageName, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="80"
                                     Margin="0,6,10,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PROJECT FEE" Style="{StaticResource Eyebrow}" />
                            <TextBox Text="{Binding PackageAmount, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="12"
                                     Margin="0,6,10,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="TESTER PAYOUT" Style="{StaticResource Eyebrow}" />
                            <TextBox Text="{Binding PackageTesterFee, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="12"
                                     Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Enter amounts in dollars, for example 15 or 15.00."
                               Style="{StaticResource Caption}" FontSize="10.5" Margin="0,6,0,0" />

                    <CheckBox Content="Active - developers can choose this package"
                              IsChecked="{Binding PackageActive}"
                              Margin="0,16,0,0"
                              FontSize="11.5"
                              Foreground="{StaticResource InkBrush}" />

                    <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                            Visibility="{Binding HasPackageError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PackageError}" FontSize="11.5"
                                   Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Save package"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SavePackageCommand}" />
                        <Button Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ClosePackageCommand}"
                                Margin="8,0,0,0" />
                        <Button Content="Delete package"
                                Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource BadBrush}"
                                Command="{Binding DeletePackageCommand}"
                                IsEnabled="{Binding CanDeletePackage}"
                                ToolTip="{Binding DeletePackageNote}"
                                Visibility="{Binding IsExistingPackage, Converter={StaticResource BoolToVisibility}}"
                                Margin="18,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeletePackageNote}"
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding IsExistingPackage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                <StackPanel>
                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="74" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PACKAGE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="1" Text="PROJECT FEE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="2" Text="TESTER PAYOUT" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="3" Text="PROJECTS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Eyebrow}" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ItemsControl ItemsSource="{Binding Packages}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="74" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}" />
                                        <TextBlock Grid.Column="1" Text="{Binding AmountLabel}" FontSize="11"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding TesterFeeLabel}" FontSize="11"
                                                   Foreground="{StaticResource InkSoftBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding CampaignsLabel}" FontSize="10.5"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding StatusLabel}" FontSize="10.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="bad">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Grid.Column="5"
                                                Content="Edit"
                                                Style="{StaticResource GhostButton}"
                                                FontSize="10.5"
                                                Padding="10,5"
                                                HorizontalAlignment="Right"
                                                Command="{Binding DataContext.EditPackageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="No payment packages yet. Create one so developers can start a project."
                               Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPackages}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
