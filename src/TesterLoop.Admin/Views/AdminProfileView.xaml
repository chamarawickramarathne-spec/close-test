<UserControl x:Class="TesterLoop.Admin.Views.AdminProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Admin profile" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="Your name and note are shown only to operations staff."
                       Style="{StaticResource Caption}" Margin="0,4,0,0" />

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasProfileError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProfileError}" FontSize="11.5"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource GoodSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasProfileToast, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ProfileToast}" FontSize="11.5"
                           Foreground="{StaticResource GoodBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="SIGN-IN EMAIL" Style="{StaticResource Eyebrow}" />
                    <TextBox Text="{Binding ProfileEmail, Mode=OneWay}"
                             IsReadOnly="True"
                             Margin="0,6,0,0"
                             Cursor="Arrow"
                             ToolTip="The sign-in email is managed in Supabase Authentication." />
                    <TextBlock Text="The sign-in email is managed in Supabase Authentication and cannot be changed here."
                               Style="{StaticResource Caption}" FontSize="10.5" Margin="0,6,0,0" />

                    <TextBlock Text="DISPLAY NAME" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                    <TextBox Text="{Binding ProfileDisplayName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="120"
                             Margin="0,6,0,0" />

                    <TextBlock Text="ADMIN NOTE" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                    <TextBox Text="{Binding ProfileNote, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="110"
                             Margin="0,6,0,0" />
                    <TextBlock Text="Optional. Visible to operations only. Up to 500 characters."
                               Style="{StaticResource Caption}" FontSize="10.5" Margin="0,6,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Save profile"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveProfileCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
