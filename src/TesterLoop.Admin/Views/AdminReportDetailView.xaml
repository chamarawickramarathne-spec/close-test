<UserControl x:Class="TesterLoop.Admin.Views.AdminReportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="DetailMetric" TargetType="TextBlock" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <Button Content="Back to feedback"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left"
                    Command="{Binding BackToFeedbackCommand}" />

            <Grid Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding ReportDetail.Title}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding ReportDetail.AppName, Mode=OneWay}" />
                        <Run Text=" &#183; " />
                        <Run Text="{Binding ReportDetail.Developer, Mode=OneWay}" />
                        <Run Text=" &#183; report " />
                        <Run Text="{Binding ReportDetail.ReportId, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource Caption}"
                               Text="{Binding ReportDetail.Package}" />
                </StackPanel>
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding ReportDetail.StatusLabel}" FontSize="11"
                               Foreground="{StaticResource InkSoftBrush}" />
                </Border>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource GoodSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Toast}" FontSize="11"
                           Foreground="{StaticResource GoodBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="SEVERITY" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding ReportDetail.SeverityLabel}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailMetric}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportDetail.SeverityTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportDetail.SeverityTone}" Value="bad">
                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding ReportDetail.StatusLabel}" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailMetric}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportDetail.StatusTone}" Value="good">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportDetail.StatusTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="FILED" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding ReportDetail.Filed}"
                                   Style="{StaticResource DetailMetric}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding ReportDetail.Age}" Style="{StaticResource Caption}"
                                   FontSize="10" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,14" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="UPDATED" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding ReportDetail.Updated}"
                                   Style="{StaticResource DetailMetric}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="TESTER" Style="{StaticResource DetailEyebrow}" Margin="0,0,0,10" />
                        <TextBlock Text="NAME" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding ReportDetail.TesterName}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="SIGN-IN EMAIL" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.TesterEmail}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="GOOGLE ACCOUNT" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.TesterGoogle}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="REGION" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.TesterRegion}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="MOBILE DEVICE" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.TesterMobile}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="DEVICES" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.TesterDevices}" Style="{StaticResource DetailValue}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PROJECT" Style="{StaticResource DetailEyebrow}" Margin="0,0,0,10" />
                        <TextBlock Text="APP" Style="{StaticResource DetailLabel}" />
                        <TextBlock Text="{Binding ReportDetail.AppName}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="DEVELOPER" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.Developer}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="PACKAGE" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.Package}" Style="{StaticResource DetailValue}" />
                        <TextBlock Text="PROJECT STATE" Style="{StaticResource DetailLabel}" Margin="0,9,0,2" />
                        <TextBlock Text="{Binding ReportDetail.CampaignState}" FontSize="11"
                                   FontWeight="SemiBold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportDetail.CampaignStateTone}" Value="good">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportDetail.CampaignStateTone}" Value="bad">
                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportDetail.CampaignStateTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="INSTALL AND USAGE AT FILING" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding ReportDetail.SnapshotState}" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailMetric}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportDetail.SnapshotTone}" Value="good">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportDetail.SnapshotTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ReportDetail.SnapshotDays}" Style="{StaticResource Caption}"
                                   FontSize="10.5" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ReportDetail.SnapshotDetail}" Style="{StaticResource DetailValue}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ReportDetail.SnapshotCaptured}" Style="{StaticResource Caption}"
                                   FontSize="10" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="CURRENT USAGE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding ReportDetail.CurrentState}" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailMetric}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReportDetail.CurrentTone}" Value="good">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ReportDetail.CurrentTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding ReportDetail.CurrentDays}" Style="{StaticResource Caption}"
                                   FontSize="10.5" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding ReportDetail.CurrentDetail}" Style="{StaticResource DetailValue}"
                                   Margin="0,8,0,0" />
                        <TextBlock Text="{Binding ReportDetail.CurrentCaptured}" Style="{StaticResource Caption}"
                                   FontSize="10" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="DAILY INSTALL CHECKS AT FILING" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Text="{Binding ReportDetail.InstallHistoryState}" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DetailMetric}">
                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReportDetail.InstallHistoryTone}" Value="good">
                                        <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReportDetail.InstallHistoryTone}" Value="warn">
                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ReportDetail.InstallHistoryTone}" Value="bad">
                                        <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding ReportDetail.InstallHistorySummary}" Style="{StaticResource DetailValue}"
                               Margin="0,8,0,0" />
                    <TextBlock Text="{Binding ReportDetail.InstallHistoryWindow}" Style="{StaticResource Caption}"
                               FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,12,0,0">
                <TextBlock Text="{Binding ReportDetail.UsageComparison}" FontSize="11"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ReportDetail.UsageComparisonTone}" Value="warn">
                                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ReportDetail.UsageComparisonTone}" Value="good">
                                    <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border Background="{StaticResource WarnSoftBrush}" BorderBrush="{StaticResource WarnBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="12,9" Margin="0,8,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReportDetail.HasPackageWarning}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ReportDetail.PackageWarning}" FontSize="11"
                           Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="REPORT" Style="{StaticResource DetailEyebrow}" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding ReportDetail.Body}" FontSize="12"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="BUILD" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ReportDetail.Build}" Style="{StaticResource DetailValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0,12,0">
                            <TextBlock Text="DEVICE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ReportDetail.Device}" Style="{StaticResource DetailValue}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0,0,0">
                            <TextBlock Text="EVIDENCE" Style="{StaticResource DetailLabel}" />
                            <TextBlock Text="{Binding ReportDetail.Evidence}" Style="{StaticResource DetailValue}" />
                            <Button Content="Copy evidence link"
                                    Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    IsEnabled="{Binding ReportDetail.HasEvidence}"
                                    Command="{Binding CopyReportEvidenceCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
