<UserControl x:Class="TesterLoop.Admin.Views.AdminTesterProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="DetailMetric" TargetType="TextBlock" BasedOn="{StaticResource Metric}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailEyebrow" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
            <Setter Property="FontSize" Value="9.5" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="ReportRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="0,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background"
                                        Value="{StaticResource SurfaceAltBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="row" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <StackPanel Orientation="Horizontal">
                <Button Content="Back to tester"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding BackToTesterActivityCommand}" />
                <Button Content="Refresh"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        Command="{Binding RefreshTesterProjectCommand}" />
            </StackPanel>

            <Grid Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding TesterProject.AppName}" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Caption}">
                        <Run Text="{Binding TesterProject.Package, Mode=OneWay}" />
                        <Run Text=" &#183; " />
                        <Run Text="{Binding TesterProject.Developer, Mode=OneWay}" />
                        <Run Text=" &#183; " />
                        <Run Text="{Binding TesterProject.SeatLabel, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <Border Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding TesterProject.CampaignStateLabel}" FontSize="11"
                               Foreground="{StaticResource InkSoftBrush}" />
                </Border>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>

            <Border Background="{StaticResource WarnSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding TesterProject.HasUsageNotice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding TesterProject.UsageNotice}" FontSize="11"
                           Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="16,14" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SEAT" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding TesterProject.SeatLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding TesterProject.SeatStateLabel}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="REPORTS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding TesterProject.ReportsLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding TesterProject.LastReport}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="PAYOUT" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding TesterProject.PayoutLabel}"
                                   Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource DetailMetric}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TesterProject.PayoutTone}" Value="good">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TesterProject.PayoutTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TesterProject.Reference}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,14" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TESTER FEE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding TesterProject.FeeLabel}" Style="{StaticResource DetailMetric}"
                                   Margin="0,4,0,0" />
                        <TextBlock Text="{Binding TesterProject.PaidLabel}" Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="SEAT TIMELINE" Style="{StaticResource DetailEyebrow}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Joined" Style="{StaticResource DetailLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding TesterProject.Joined}"
                                       Style="{StaticResource DetailValue}" />
                            <TextBlock Grid.Row="1" Text="Opt-in" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TesterProject.OptIn}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="Seat state" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TesterProject.Dropped}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Text="Last report" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TesterProject.LastReport}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Text="First opt-in" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TesterProject.FirstOptIn}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="5" Text="Clock started" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TesterProject.ClockStarted}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="6" Text="Eligible on" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TesterProject.EligibleOn}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="INSTALL AND USAGE" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Text="{Binding TesterProject.UsageStateLabel}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding TesterProject.UsageTone}" Value="good">
                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding TesterProject.UsageTone}" Value="warn">
                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding TesterProject.UsageDaysLabel}" Style="{StaticResource DetailValue}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding TesterProject.UsageDetail}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Only this project's package is checked, once per day."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,16" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="PAYOUT RECORD" Style="{StaticResource DetailEyebrow}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="State" Style="{StaticResource DetailLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding TesterProject.PayoutLabel}"
                                       Style="{StaticResource DetailValue}" />
                            <TextBlock Grid.Row="1" Text="Reference" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TesterProject.Reference}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Text="Paid" Style="{StaticResource DetailLabel}" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TesterProject.PaidLabel}"
                                       Style="{StaticResource DetailValue}" Margin="0,6,0,0" />
                        </Grid>
                        <TextBlock Text="A payout is recorded only after the project passes and this tester has filed a report."
                                   Style="{StaticResource Caption}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                <StackPanel>
                    <TextBlock Text="THIS TESTER'S REPORTS" Style="{StaticResource DetailEyebrow}" />
                    <TextBlock Text="Select a report to open the full report, including the usage snapshot and daily install checks."
                               Style="{StaticResource Caption}" Margin="0,4,0,0" />

                    <Grid Margin="0,14,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="REPORT" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="1" Text="SEVERITY" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="3" Text="USAGE AT FILING" Style="{StaticResource DetailEyebrow}" />
                        <TextBlock Grid.Column="4" Text="FILED" Style="{StaticResource DetailEyebrow}"
                                   TextAlignment="Right" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource LineBrush}" />

                    <ItemsControl ItemsSource="{Binding TesterProject.Reports}" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ReportRowButton}"
                                        ToolTip="{Binding Tooltip}"
                                        Command="{Binding DataContext.OpenTesterProjectReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="72" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding Preview}" Style="{StaticResource Caption}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                       FontSize="9.5"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SeverityLabel}" FontSize="10.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SeverityTone}" Value="bad">
                                                            <Setter Property="Foreground" Value="{StaticResource BadBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding SeverityTone}" Value="warn">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="10.5"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusTone}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding StatusTone}" Value="warn">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding UsageLabel}" FontSize="10"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UsageTone}" Value="good">
                                                            <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding UsageTone}" Value="warn">
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding Filed}"
                                                   Style="{StaticResource Caption}" FontSize="10"
                                                   VerticalAlignment="Center" TextAlignment="Right" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="This tester has not filed a report on this project." Margin="0,14,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TesterProject.HasReports}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
