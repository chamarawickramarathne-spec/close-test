<UserControl x:Class="TesterLoop.Admin.Views.AdminTestersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TesterLoop.Admin.Views"
             FontFamily="{StaticResource UiFont}">

    <TabControl SelectedIndex="{Binding TesterPageIndex}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Header="Tester list">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,36">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="Testers" FontSize="21" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="The tester roster. Select a tester to audit projects, reports and payouts."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="12,6"
                                    Margin="0,0,8,0">
                                <TextBlock Text="{Binding TesterTabLabel}" FontSize="11.5"
                                           Foreground="{StaticResource InkSoftBrush}" />
                            </Border>
                            <Button Content="Refresh"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}" FontSize="11.5"
                                   Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20,18">
                        <StackPanel>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="165" />
                                    <ColumnDefinition Width="85" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TESTER" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="1" Text="SIGN-IN EMAIL" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="2" Text="GOOGLE ACCOUNT" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="3" Text="REGION" Style="{StaticResource Eyebrow}" />
                                <TextBlock Grid.Column="4" Text="SCORE" Style="{StaticResource Eyebrow}"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="PROJECTS" Style="{StaticResource Eyebrow}"
                                           TextAlignment="Right" />
                                <TextBlock Grid.Column="6" Text="STATUS" Style="{StaticResource Eyebrow}"
                                           TextAlignment="Right" />
                            </Grid>

                            <Border Height="1" Background="{StaticResource LineBrush}" />

                            <ListBox ItemsSource="{Binding Testers}"
                                     SelectedItem="{Binding SelectedTesterRow}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="0,2,0,0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="row" CornerRadius="7" Padding="0,9"
                                                            Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource SurfaceAltBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="165" />
                                                <ColumnDefinition Width="165" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="72" />
                                                <ColumnDefinition Width="76" />
                                                <ColumnDefinition Width="62" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Email}" FontSize="11"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Email}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Google}" FontSize="11"
                                                       Foreground="{StaticResource InkSoftBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Google}" />
                                            <TextBlock Grid.Column="3" Text="{Binding Region}" Style="{StaticResource Caption}"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="4" Text="{Binding Reliability}" Style="{StaticResource Caption}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="5" Text="{Binding Joined}" Style="{StaticResource Caption}"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="6" Text="{Binding StateLabel}" FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="good">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="No testers have signed up yet." Margin="0,14,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasTesters}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="Tester detail">
            <views:AdminTesterDetailView />
        </TabItem>

        <TabItem Header="Tester project activity">
            <views:AdminTesterProjectView />
        </TabItem>

        <TabItem Header="Tester report detail">
            <views:AdminReportDetailView />
        </TabItem>
    </TabControl>
</UserControl>
