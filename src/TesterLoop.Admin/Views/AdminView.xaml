<UserControl x:Class="TesterLoop.Admin.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TesterLoop.Admin.Views"
             FontFamily="{StaticResource UiFont}">

    <TabControl SelectedIndex="{Binding SelectedTabIndex}"
                Background="Transparent"
                BorderThickness="0"
                Padding="0">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <TabPanel IsItemsHost="True" Visibility="Collapsed" />
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </Grid>
            </ControlTemplate>
        </TabControl.Template>
        <TabItem Header="Operations">
            <views:AdminOperationsView />
        </TabItem>
        <TabItem Header="Close Test Projects">
            <views:AdminCampaignsView />
        </TabItem>
        <TabItem Header="Developers">
            <views:AdminDevelopersView />
        </TabItem>
        <TabItem Header="Testers">
            <views:AdminTestersView />
        </TabItem>
        <TabItem Header="Feedback">
            <views:AdminFeedbackView />
        </TabItem>
        <TabItem Header="Payment Packages">
            <views:AdminPackagesView />
        </TabItem>
        <TabItem Header="Audit Trail">
            <views:AdminAuditView />
        </TabItem>
        <TabItem Header="Profile">
            <views:AdminProfileView />
        </TabItem>
    </TabControl>
</UserControl>
