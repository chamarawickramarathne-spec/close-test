<UserControl x:Class="TesterLoop.Desktop.Views.DeveloperProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <StackPanel Margin="0,0,16,0">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <StackPanel>
                            <TextBlock Text="NEW PROJECT" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="App name" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                            <TextBox Text="{Binding NewAppName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Package name" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                            <TextBox Text="{Binding NewPackage, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Like com.company.app"
                           Style="{StaticResource Caption}" FontSize="10.5" Margin="0,4,0,0" />
                <TextBlock Text="Payment package" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                <ComboBox ItemsSource="{Binding Packages}"
                          SelectedItem="{Binding SelectedPackage}"
                          DisplayMemberPath="Name"
                          Padding="8,6"
                          FontSize="12" />
                <TextBlock Text="{Binding SelectedPackageDetail}"
                           Style="{StaticResource Caption}" FontSize="10.5" Margin="0,4,0,0"
                           TextWrapping="Wrap" />
                <Border Background="{StaticResource BadSoftBrush}" CornerRadius="8" Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding HasPackageError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding PackageError}" FontSize="10.5"
                               Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
                </Border>
                <Button Content="Create project"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding CreateProjectCommand}"
                                    Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="YOUR PROJECTS" Style="{StaticResource Eyebrow}" Margin="2,0,0,10" />
                            <ListBox ItemsSource="{Binding Campaigns}"
                                     SelectedItem="{Binding SelectedCampaign}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MaxHeight="330"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="row" CornerRadius="9" Padding="11,9" Margin="0,2"
                                                            Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource SurfaceAltBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="row" Property="Background"
                                                                    Value="{StaticResource AccentSoftBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}" />
                                                <TextBlock Text="{Binding SeatsLabel}" FontSize="10.5"
                                                           Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No projects yet."
                                       Margin="2,6,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCampaigns}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
    </StackPanel>
</UserControl>
