<UserControl x:Class="TesterLoop.Desktop.Views.ResetPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource RailBrush}" Padding="52,48">
            <StackPanel VerticalAlignment="Center" MaxWidth="430" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="TL" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TesterLoop" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Account recovery" FontSize="10.5"
                                   Foreground="{StaticResource RailTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Get back to the clock."
                           Margin="0,42,0,0"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Text="We send a one-time code to the email on your account. Enter it with a new password and you are back in."
                           Margin="0,14,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource RailTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="21" />
                <Border Background="#18213A" CornerRadius="10" Padding="14" Margin="0,26,0,0">
                    <TextBlock Text="The reset code is short-lived. If it does not arrive, check spam and wait a minute before requesting another."
                               FontSize="11"
                               Foreground="{StaticResource RailTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="400" Margin="36" VerticalAlignment="Center">
                <Button Content="← Back to sign in"
                        Style="{StaticResource QuietButton}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left" />

                <TextBlock Text="RESET PASSWORD" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                <TextBlock Text="Find your account" Style="{StaticResource H1}" Margin="0,8,0,0" />
                <TextBlock Text="Start with the email you sign in with."
                           Style="{StaticResource Caption}"
                           FontSize="12"
                           Margin="0,7,0,0" />

                <TextBlock Text="EMAIL" Style="{StaticResource Eyebrow}" Margin="0,22,0,7" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <Button Content="Send reset code"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SendCodeCommand}"
                        Padding="14,11"
                        Margin="0,16,0,0" />

                <Border Background="{StaticResource GoodSoftBrush}"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}"
                               FontSize="11.5"
                               Foreground="{StaticResource GoodBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <StackPanel Visibility="{Binding CanEnterCode, Converter={StaticResource BoolToVisibility}}">
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,24,0,0" />
                    <TextBlock Text="RESET CODE" Style="{StaticResource Eyebrow}" Margin="0,20,0,7" />
                    <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Paste the code from the reset email."
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,4,0,0" />

                    <TextBlock Text="NEW PASSWORD" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                    <PasswordBox x:Name="NewPasswordInput" PasswordChanged="OnPasswordChanged" />
                    <TextBlock Text="At least 8 characters."
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,4,0,0" />

                    <Button Content="Set new password"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ResetCommand}"
                            Padding="14,11"
                            Margin="0,18,0,0" />
                </StackPanel>

                <Border Background="{StaticResource BadSoftBrush}"
                        CornerRadius="8"
                        Padding="10,8"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Error}"
                               FontSize="11.5"
                               Foreground="{StaticResource BadBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
