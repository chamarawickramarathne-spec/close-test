<UserControl x:Class="TesterLoop.Desktop.Views.SignUpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource CanvasBrush}"
             FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*" />
            <ColumnDefinition Width="1.15*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource RailBrush}" Padding="48,44">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="TL" FontSize="14" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TesterLoop" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Closed testing ops" FontSize="10.5"
                                   Foreground="{StaticResource RailTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Two accounts. One shared 14-day clock."
                           Margin="0,40,0,0"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="White"
                           TextWrapping="Wrap"
                           LineHeight="32" />
                <TextBlock Text="Developers create the project they need tested. Testers keep seats warm. Operations attach a Google Group to every campaign by hand, so nothing here pretends to call an API that does not exist."
                           Margin="0,16,0,0"
                           FontSize="12.5"
                           Foreground="{StaticResource RailTextBrush}"
                           TextWrapping="Wrap"
                           LineHeight="21" />
                <Border Background="#18213A" CornerRadius="10" Padding="14" Margin="0,30,0,0">
                    <TextBlock Text="Use the Google account email you will add to the Play Console tester list as your sign-in email."
                               FontSize="11"
                               Foreground="{StaticResource RailTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="17" />
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="420" Margin="36,36" VerticalAlignment="Center">
                <Button Content="← Back to sign in"
                        Style="{StaticResource QuietButton}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left" />

                <StackPanel Visibility="{Binding IsFormVisible, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="CREATE ACCOUNT" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                    <TextBlock Text="Join TesterLoop" Style="{StaticResource H1}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding RoleHint}"
                               Style="{StaticResource Caption}"
                               FontSize="12"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="ACCOUNT TYPE" Style="{StaticResource Eyebrow}" Margin="0,22,0,7" />
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding SelectedRole}"
                              Padding="8,6"
                              FontSize="13" />

                    <TextBlock Text="YOUR NAME" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                    <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Visibility="{Binding IsDeveloper, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="COMPANY / STUDIO" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsTester, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="REGION" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                        <TextBox Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="DEVICES" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                        <TextBox Text="{Binding Devices, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Separate devices with commas."
                                   Style="{StaticResource Caption}"
                                   FontSize="10.5"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <TextBlock Text="SIGN-IN EMAIL" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="This is also the Google address used for Play testing."
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,4,0,0" />

                    <TextBlock Text="PASSWORD" Style="{StaticResource Eyebrow}" Margin="0,16,0,7" />
                    <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                    <TextBlock Text="At least 8 characters."
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,4,0,0" />

                    <Border Background="{StaticResource BadSoftBrush}"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource BadBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Create account"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding CreateCommand}"
                            Padding="14,11"
                            Margin="0,20,0,0" />

                    <TextBlock Text="We email a 24-hour activation link before the account can be used."
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,14,0,0"
                               TextWrapping="Wrap" />

                    <TextBlock Text="Operations accounts are created by the TesterLoop team. Email admin@testerloop.dev if you need staff access."
                               Style="{StaticResource Caption}"
                               FontSize="10.5"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Visibility="{Binding IsCreated, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="CHECK YOUR EMAIL" Style="{StaticResource Eyebrow}" Margin="0,18,0,0" />
                    <TextBlock Text="Activate your account" Style="{StaticResource H1}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Caption}"
                               FontSize="12"
                               Margin="0,7,0,0"
                               TextWrapping="Wrap">
                        <Run Text="We sent an activation link to " /><Run Text="{Binding CreatedEmail, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Open it within 24 hours to switch the account on, then sign in." />
                    </TextBlock>

                    <Border Background="{StaticResource GoodSoftBrush}"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,16,0,0"
                            Visibility="{Binding HasResendStatus, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding ResendStatus}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource GoodBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Background="{StaticResource BadSoftBrush}"
                            CornerRadius="8"
                            Padding="10,8"
                            Margin="0,14,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}"
                                   FontSize="11.5"
                                   Foreground="{StaticResource BadBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Go to sign in"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding BackCommand}"
                            Padding="14,11"
                            Margin="0,20,0,0" />

                    <Button Content="Resend activation email"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding ResendCommand}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
