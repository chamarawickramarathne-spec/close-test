<UserControl x:Class="TesterLoop.Desktop.Views.TesterWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,36">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0">
                        <Run Text="{Binding Email, Mode=OneWay}" />
                        <Run Text=" &#183; " />
                        <Run Text="{Binding Region, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <Border Background="{StaticResource BadSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Error}" FontSize="11.5"
                           Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" />
            </Border>
            <Border Background="{StaticResource GoodSoftBrush}" CornerRadius="9" Padding="12,9" Margin="0,14,0,0"
                    Visibility="{Binding HasToast, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding Toast}" FontSize="11.5"
                           Foreground="{StaticResource GoodBrush}" TextWrapping="Wrap" />
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="PROJECTS JOINED" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding ProjectCountLabel}" Style="{StaticResource Metric}" />
                        <TextBlock Text="No limit on projects" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="ACTIVE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding ActiveCount}" Style="{StaticResource Metric}" />
                        <TextBlock Text="Opted in now" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,7,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="RELIABILITY" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding ReliabilityLabel}" Style="{StaticResource Metric}" />
                        <TextBlock Text="From completed seats" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="MOBILE DEVICE" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding MobileDeviceLabel}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MobileDeviceNote}" Style="{StaticResource Caption}"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="TEST ON MOBILE" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="Install TesterLoop Mobile to test projects"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="0,8,0,0" />
                    <TextBlock Text="Confirm opt-in, check app installs, share daily usage and file reports from the Android app. Sign in with this same TesterLoop account."
                               Style="{StaticResource Body}" Margin="0,5,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="No public download link is configured. Ask operations for the install link."
                               Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="OPEN CAMPAIGNS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding AvailableLabel}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Available}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FlatCard}" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding Package}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                                       Margin="0,3,0,0" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,4,0,0">
                                                <Run Text="{Binding SeatsLeft, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Requirement, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding GroupEmail}" Style="{StaticResource Caption}"
                                                       FontSize="10.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Join"
                                                Style="{StaticResource PrimaryButton}"
                                                VerticalAlignment="Center"
                                                Command="{Binding DataContext.JoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanJoin}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No open campaigns right now. New projects appear here once operations attaches a group and the developer saves the Play link."
                               Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasAvailable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="MY CAMPAIGNS" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="{Binding MineCountLabel}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Mine}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FlatCard}" Margin="0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AppName}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding SeatNo}" Style="{StaticResource Caption}" />
                                                <TextBlock Text="{Binding DaysIn}" Style="{StaticResource Caption}"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="good">
                                                                <Setter Property="Foreground" Value="{StaticResource GoodBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding VerificationNote}" Style="{StaticResource Caption}"
                                                       FontSize="10.5" Margin="0,2,0,0" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding GroupEmail}" Style="{StaticResource Caption}"
                                                       FontSize="10.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Google Group"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="Open Play"
                                                    Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,6,0" />
                                            <Button Content="{Binding OptInLabel}"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.OptInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Join a campaign to see it here. Confirm opt-in in the TesterLoop mobile app after installing the build from the Play link."
                               Margin="0,8,0,0" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMine}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                    <StackPanel>
                        <TextBlock Text="FILE A REPORT" Style="{StaticResource Eyebrow}" />
                        <TextBlock Text="Project" Style="{StaticResource Caption}" Margin="0,12,0,5" />
                        <ComboBox ItemsSource="{Binding Mine}"
                                  SelectedItem="{Binding SelectedReportCampaign}"
                                  DisplayMemberPath="AppName"
                                  Padding="8,6" FontSize="12.5" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Severity" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <ComboBox ItemsSource="{Binding Severities}"
                                          SelectedItem="{Binding SelectedSeverity}"
                                          DisplayMemberPath="Label"
                                          Padding="8,6" FontSize="12.5" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Build" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ReportBuild, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Title" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                        <TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="What happened" Style="{StaticResource Caption}" Margin="0,10,0,5" />
                        <TextBox Text="{Binding ReportBody, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                                 VerticalScrollBarVisibility="Auto" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="Device (from mobile app)" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ReportDevice, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="Evidence URL" Style="{StaticResource Caption}" Margin="0,0,0,5" />
                                <TextBox Text="{Binding ReportEvidence, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Button Content="File report"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding FileReportCommand}"
                                Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MY REPORTS" Style="{StaticResource Eyebrow}" />
                            <TextBlock Text="{Binding ReportsLabel}" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding MyReports}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6">
                                        <Grid>
                                            <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InkBrush}" />
                                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0">
                                            <Run Text="{Binding AppName, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SeverityLabel, Mode=OneWay}" />
                                            <Run Text=" · " />
                                             <Run Text="{Binding When, Mode=OneWay}" />
                                         </TextBlock>
                                         <TextBlock Text="{Binding Usage}" Style="{StaticResource Caption}"
                                                    FontSize="10" Margin="0,2,0,0" />
                                         <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="No reports filed yet." Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasReports}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
