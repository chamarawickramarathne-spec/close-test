<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F6F8" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="LineBrush" Color="#E6E9EF" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#D3D8E2" />

    <SolidColorBrush x:Key="InkBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="InkSoftBrush" Color="#475569" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A94A6" />

    <SolidColorBrush x:Key="RailBrush" Color="#0E1526" />
    <SolidColorBrush x:Key="RailHoverBrush" Color="#1B2437" />
    <SolidColorBrush x:Key="RailTextBrush" Color="#AEB8C9" />

    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF0FF" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#C9CDFB" />

    <SolidColorBrush x:Key="GoodBrush" Color="#0E9F6E" />
    <SolidColorBrush x:Key="GoodSoftBrush" Color="#E6F6F0" />
    <SolidColorBrush x:Key="WarnBrush" Color="#B45309" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FDF1DF" />
    <SolidColorBrush x:Key="BadBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="BadSoftBrush" Color="#FDECEC" />
    <SolidColorBrush x:Key="TrackBrush" Color="#EDF0F5" />

    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="Metric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
