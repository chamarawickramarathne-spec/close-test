<UserControl x:Class="TesterLoop.Desktop.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}">

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource RailBrush}">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="TL"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="TesterLoop"
                                   FontSize="14.5"
                                   FontWeight="SemiBold"
                                   Foreground="White" />
                        <TextBlock Text="Closed testing ops"
                                   FontSize="10.5"
                                   Foreground="{StaticResource RailTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,26,0,10"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding Command}"
                                        HorizontalContentAlignment="Left"
                                        Cursor="Hand"
                                        Margin="0,1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Foreground" Value="{StaticResource RailTextBrush}" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="row"
                                                                Background="Transparent"
                                                                CornerRadius="9"
                                                                Padding="11,9">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="row" Property="Background"
                                                                        Value="{StaticResource RailHoverBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="row" Property="Background"
                                                                        Value="{StaticResource AccentBrush}" />
                                                                <Setter Property="Foreground" Value="White" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Label}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="SIGNED IN"
                               Margin="2,0,0,8"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#5D6A82" />
                    <Border Background="#18213A"
                            CornerRadius="11"
                            Padding="12">
                        <StackPanel>
                            <Border Width="38" Height="38"
                                    CornerRadius="19"
                                    Background="{StaticResource AccentBrush}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Initials}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding UserName}"
                                       Margin="0,10,0,0"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RoleLabel}"
                                       Margin="0,3,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource RailTextBrush}" />
                            <TextBlock Text="{Binding UserEmail}"
                                       Margin="0,2,0,0"
                                       FontSize="10.5"
                                       Foreground="#5D6A82"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Button Content="Sign out"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding SignOutCommand}" />
                    <Border Background="#18213A" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="MANUAL GROUPS"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="#7D8AA3" />
                            <TextBlock Text="Operations creates each Google Group by hand and attaches its address. No group API is used."
                                       Margin="0,5,0,0"
                                       FontSize="10.5"
                                       Foreground="{StaticResource RailTextBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="15" />
                        </StackPanel>
                    </Border>
                    <Button Content="{Binding Updates.ButtonLabel}"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding Updates.UpdateCommand}"
                            Margin="0,10,0,0" />
                    <TextBlock Text="{Binding Updates.Status}"
                               Margin="2,6,0,0"
                               FontSize="10"
                               Foreground="{StaticResource RailTextBrush}"
                               TextWrapping="Wrap"
                               LineHeight="14"
                               Visibility="{Binding Updates.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="#3A1D24" CornerRadius="8" Padding="9" Margin="0,10,0,0"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding Error}" FontSize="10.5" Foreground="#FCA5A5"
                                   TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding VersionLabel}"
                               Margin="2,14,0,0"
                               FontSize="10"
                               Foreground="#5D6A82" />
                    <TextBlock Text="Windows x86 / x64"
                               Margin="2,2,0,0"
                               FontSize="10"
                               Foreground="#5D6A82" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="30,18">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding HeaderSubtitle}"
                                   Margin="0,3,0,0"
                                   Style="{StaticResource Caption}"
                                   FontSize="12" />
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Border Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="{StaticResource AccentLineBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10,6"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding RoleBadge}"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12,6">
                            <TextBlock Text="{Binding UserEmail}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource InkSoftBrush}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding View}" />
        </Grid>

        <ItemsControl Grid.ColumnSpan="2"
                      Panel.ZIndex="60"
                      ItemsSource="{Binding Notifications.Items}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Width="360"
                      Margin="0,16,18,0"
                      IsHitTestVisible="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="10"
                            Padding="14,11"
                            Margin="0,0,0,8"
                            BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource GoodSoftBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource GoodBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ToneName}" Value="bad">
                                        <Setter Property="Background" Value="{StaticResource BadSoftBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BadBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ToneName}" Value="info">
                                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource InkSoftBrush}" />
                            <TextBlock Text="{Binding Message}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource InkBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.ColumnSpan="2"
              Panel.ZIndex="70"
              Background="#66000000"
              Visibility="{Binding Notifications.IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding Notifications.CancelConfirmCommand}" />
            </Grid.InputBindings>
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="14"
                    Padding="26,24"
                    Width="430"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding Notifications.ConfirmTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="{Binding Notifications.ConfirmMessage}"
                               FontSize="12"
                               Foreground="{StaticResource InkSoftBrush}"
                               TextWrapping="Wrap"
                               Margin="0,9,0,0" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,22,0,0">
                        <Button Content="{Binding Notifications.CancelLabel}"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding Notifications.CancelConfirmCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="{Binding Notifications.ConfirmLabel}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding Notifications.AcceptConfirmCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
